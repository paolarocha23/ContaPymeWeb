# ============================================================
# ContaPyme – Variables de Entorno
# ============================================================

# Servidor Backend
PORT=5000
NODE_ENV=development

# Base de Datos MySQL Local (Local instance MySql80)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=contapyme

# Seguridad y Autenticación JWT
JWT_SECRET=contapyme_super_secret_jwt_key_2026_xyz987654321
JWT_EXPIRES_IN=8h
JWT_2FA_SECRET=contapyme_temp_2fa_token_key_abcdef123456

# Configuración de Correo Electrónico (Nodemailer)
# Para desarrollo: si dejas SMTP_HOST vacío o falso, se mostrarán los códigos 2FA
# y enlaces de recuperación en la consola del servidor y en la respuesta de desarrollo.
# Para producción: descomenta y coloca los datos de tu servidor SMTP (Gmail, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mreancontl@gmail.com
SMTP_PASS=ymhughltlecrkbqr
EMAIL_FROM="ContaPyme"

# Configuración de Inactividad (en minutos)
INACTIVITY_TIMEOUT_MINUTES=15
