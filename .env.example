PORT=5000
NODE_ENV=development

# Cadena de conexión de Supabase (Dashboard -> Connect -> Connection string)
# Usa la opción "Session pooler" para conexiones desde un servidor Node.
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres
# Dejar en true para Supabase (SSL obligatorio). Usar false solo en PostgreSQL local.
DB_SSL=true
DB_POOL_MAX=15

JWT_SECRET=contapyme_super_secret_jwt_key_2026_xyz987654321
JWT_EXPIRES_IN=8h
JWT_2FA_SECRET=contapyme_temp_2fa_token_key_abcdef123456

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ContaPyme Seguridad" <no-reply@contapyme.com>

INACTIVITY_TIMEOUT_MINUTES=15
